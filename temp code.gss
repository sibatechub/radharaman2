function getExamInfo() {


 const ss =
   SpreadsheetApp.openById(
     LOGIN_SPREADSHEET_ID
   );


 const sheet =
   ss.getSheetByName(
     "Exam_Details"
   );


 const data =
   sheet.getDataRange()
   .getValues();


 const today =
   Utilities.formatDate(
     new Date(),
     Session.getScriptTimeZone(),
     "dd-MM-yyyy"
   );


 for(let i=1;i<data.length;i++){


   const rowDate =
     Utilities.formatDate(
       new Date(data[i][1]),
       Session.getScriptTimeZone(),
       "dd-MM-yyyy"
     );


   if(rowDate === today){


     return {


       date: rowDate,
       examName: data[i][2],
       totalShift: data[i][3]


     };


   }


 }


 return {


   date: today,
   examName: "No Exam Scheduled",
   totalShift: "-"


 };


}
function loginUser(
  resourceId,
  password,
  latitude,
  longitude
){

  const ss =
    SpreadsheetApp.openById(LOGIN_SPREADSHEET_ID);

  const staffSheet =
    ss.getSheetByName("STAFF_MASTER");

  const data =
    staffSheet.getDataRange().getValues();

  for(let i=1;i<data.length;i++){

    if(
      String(data[i][9]).trim() ===
      String(resourceId).trim()
    ){

      // Password incorrect
      if(
        String(data[i][11]).trim() !==
        String(password).trim()
      ){

        return{
          success:false,
          message:"Invalid Password"
        };

      }

      // Staff not assigned today
      if(
        String(data[i][10]).trim().toUpperCase() !== "YES"
      ){

        return{
          success:false,
          message:"You are not mapped for today's examination duty.\n\nPlease contact your Center Head."
        };

      }

      // Login Success
      return{

        success:true,

        name:data[i][1],
        mobile:data[i][2],
        email:data[i][3],

        dob:Utilities.formatDate(
          new Date(data[i][4]),
          Session.getScriptTimeZone(),
          "dd/MM/yyyy"
        ),

        aadhar:data[i][5],
        address:data[i][6],
        employment:data[i][7],
        role:data[i][8],
        resourceId:data[i][9],
        status:data[i][10]

      };

    }

  }

  // Resource ID not found
  return{

    success:false,
    message:"Invalid Resource ID"

  };

}
function getTodayAttendance(resourceId){

  const ss =
    SpreadsheetApp.openById(
      LOGIN_SPREADSHEET_ID
    );

  const sheet =
    ss.getSheetByName(
      "ATTENDANCE_LOG"
    );

  const data =
    sheet.getDataRange()
    .getValues();

  const today =
    Utilities.formatDate(
      new Date(),
      Session.getScriptTimeZone(),
      "dd-MM-yyyy"
    );

  for(let i=data.length-1;i>=1;i--){

    const rowDate =
      Utilities.formatDate(
        new Date(data[i][0]),
        Session.getScriptTimeZone(),
        "dd-MM-yyyy"
      );

    if(
      rowDate === today &&
      String(data[i][9]).trim() ===
      String(resourceId).trim()
    ){

      return {

        found:true,

        checkIn:
        data[i][10]
        ?
        Utilities.formatDate(
          new Date(data[i][10]),
          Session.getScriptTimeZone(),
          "hh:mm a"
        )
        :
        "-",

        checkOut:
        data[i][11]
        ?
        Utilities.formatDate(
          new Date(data[i][11]),
          Session.getScriptTimeZone(),
          "hh:mm a"
        )
        :
        "-",

        duration:
        data[i][12] || "-",

        status:
        data[i][20] || "-"

      };

    }

  }

  return {found:false};

}
function calculateDistance(
 lat1,
 lon1,
 lat2,
 lon2
) {


 const R = 6371000;


 const dLat =
   (lat2 - lat1) *
   Math.PI / 180;


 const dLon =
   (lon2 - lon1) *
   Math.PI / 180;


 const a =


   Math.sin(dLat / 2) *
   Math.sin(dLat / 2)


   +


   Math.cos(
     lat1 * Math.PI / 180
   )


   *


   Math.cos(
     lat2 * Math.PI / 180
   )


   *


   Math.sin(dLon / 2) *
   Math.sin(dLon / 2);


 const c =
   2 *
   Math.atan2(
     Math.sqrt(a),
     Math.sqrt(1 - a)
   );


 return R * c;


}
function saveCheckIn(
  userData,
  latitude,
  longitude,
  fullDevice,
  deviceInfo
){


 const ss =
   SpreadsheetApp.openById(
