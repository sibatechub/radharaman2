function changePassword(resourceId, oldPassword, newPassword){

const ss =
SpreadsheetApp.openById(LOGIN_SPREADSHEET_ID);

const sheet =
ss.getSheetByName("STAFF_MASTER");

const data =
sheet.getDataRange().getValues();

for(let i=1;i<data.length;i++){

if(String(data[i][9]).trim()==String(resourceId).trim()){

if(String(data[i][11]).trim()!=String(oldPassword).trim()){

return{

success:false,

message:"Current Password is incorrect."

};

}

sheet.getRange(i+1,12).setValue(newPassword);

return{

success:true,

message:"Password Changed Successfully.\nPlease Login Again."

};

}

}

return{

success:false,

message:"User Not Found."

};

}
function getStaffList(adminResourceId){

  const ss =
    SpreadsheetApp.openById(LOGIN_SPREADSHEET_ID);

  const sheet =
    ss.getSheetByName("STAFF_MASTER");

  const data =
    sheet.getDataRange().getValues();

  // Verify Admin
  let isAdmin = false;

  for(let i = 1; i < data.length; i++){

    if(
      String(data[i][9]).trim() ===
      String(adminResourceId).trim() &&
      String(data[i][8]).trim() === "Admin" &&
      String(data[i][10]).trim().toUpperCase() === "YES"
    ){

      isAdmin = true;
      break;

    }

  }

  if(!isAdmin){

    throw new Error("Only Admin can access Staff Management.");

  }

  let result = [];

  for(let i = 1; i < data.length; i++){

    // Exclude Admin
    if(
      String(data[i][8]).trim().toLowerCase() === "admin"
    ){
      continue;
    }

    result.push({

      resourceId: data[i][9],

      name: data[i][1],

      role: data[i][8],

      active: data[i][10],

      shift: data[i][12]

    });

  }

  return result;

}

function updateStaffStatus(list, adminResourceId){

  const ss =
    SpreadsheetApp.openById(LOGIN_SPREADSHEET_ID);

  const sheet =
    ss.getSheetByName("STAFF_MASTER");

  const settings =
    ss.getSheetByName("SETTINGS");

  const ownerEmail =
    settings.getRange("D2").getValue();

  const data =
    sheet.getDataRange().getValues();

  // =================================
  // VERIFY ADMIN
  // =================================

  let isAdmin = false;

  for(let i = 1; i < data.length; i++){

    if(
      String(data[i][9]).trim() ===
      String(adminResourceId).trim() &&
      String(data[i][8]).trim() === "Admin" &&
      String(data[i][10]).trim().toUpperCase() === "YES"
    ){

      isAdmin = true;
      break;

    }

  }

  if(!isAdmin){

    throw new Error("Only Admin can update staff details.");

  }

  // =================================
  // ALLOWED ROLES
  // =================================

  const allowedRoles = [
    "Center Head",
    "IT",
    "Invigilator",
    "Electrician",
    "MAF",
    "Security",
    "CCTV Operator"
  ];

  // =================================
  // STORE ROLE CHANGES
  // =================================

  let roleChanges = [];

  // =================================
  // UPDATE STAFF DETAILS
  // =================================

  list.forEach(function(emp){

    for(let i = 1; i < data.length; i++){

      if(
        String(data[i][9]).trim() ===
        String(emp.resourceId).trim()
      ){

        const oldRole =
          String(data[i][8]).trim();

        const newRole =
          String(emp.role).trim();

        // Validate role
        if(!allowedRoles.includes(newRole)){

          throw new Error(
            "Invalid role selected for " + data[i][1]
          );

        }

        // Update Role - Column I
        sheet.getRange(i + 1, 9).setValue(newRole);

        // Update Active - Column K
        sheet.getRange(i + 1, 11).setValue(emp.active);

        // Update Shift - Column M
        sheet.getRange(i + 1, 13).setValue(emp.shift);

        // Record role changes
        if(oldRole !== newRole){

          roleChanges.push({

            name: data[i][1],

            resourceId: data[i][9],

            oldRole: oldRole,

            newRole: newRole

          });

        }

        break;

      }

    }

  });

  SpreadsheetApp.flush();

  // =================================
  // RELOAD UPDATED DATA
  // =================================

  const rows =
    sheet.getDataRange().getValues();

  const today = Utilities.formatDate(
    new Date(),
    Session.getScriptTimeZone(),
    "dd/MM/yyyy hh:mm a"
  );

  // =================================
  // DYNAMIC ROLE SUMMARY
  // EXCLUDE ADMIN
  // =================================

  const roleOrder = [
  "Center Head",
  "IT",
  "Electrician",
  "Invigilator",
  "MAF",
  "Security",
  "CCTV Operator"
];

let roleSummary = {};

  rows.slice(1).forEach(function(r){

    const role = String(r[8]).trim();

    const active =
      String(r[10]).trim().toUpperCase();

    if(
      active === "YES" &&
      role.toLowerCase() !== "admin" &&
      role !== ""
    ){

      if(!roleSummary[role]){

        roleSummary[role] = 0;

      }

      roleSummary[role]++;

    }

  });

  // =================================
  // SUMMARY HTML
  // =================================

  let summaryHtml = "";

roleOrder.forEach(function(role){

  if(roleSummary[role]){

    summaryHtml += `

      <tr>

        <td><b>Total ${role}</b></td>

        <td>${roleSummary[role]}</td>

      </tr>

    `;

  }

});

  if(summaryHtml === ""){

    summaryHtml = `
      <tr>
        <td colspan="2">No Active Staff</td>
      </tr>
    `;

  }

  // =================================
  // ROLE CHANGE REPORT
  // =================================

  let roleChangeHtml = "";

  if(roleChanges.length > 0){

    roleChangeHtml = `

    <br>

    <h3>Role Changes</h3>

    <table border="1" cellpadding="8" cellspacing="0"
    style="border-collapse:collapse;">

      <tr style="background:#1e3a8a;color:white;">

        <th>Name</th>
        <th>Resource ID</th>
        <th>Previous Role</th>
        <th>Updated Role</th>

      </tr>

    `;

    roleChanges.forEach(function(emp){

      roleChangeHtml += `

      <tr>

        <td>${emp.name}</td>

        <td>${emp.resourceId}</td>

        <td>${emp.oldRole}</td>

        <td>${emp.newRole}</td>

      </tr>

      `;

    });

    roleChangeHtml += `</table>`;

  }

  // =================================
  // EMAIL HTML
  // =================================

  let html = `

  <h2>Staff Duty Assignment Updated</h2>

  <p>
    <b>Updated On :</b> ${today}
  </p>

  <h3>Staff Summary</h3>

  <table border="1" cellpadding="6" cellspacing="0"
  style="border-collapse:collapse;">

    ${summaryHtml}

  </table>

  ${roleChangeHtml}

  <br><br>

  <h3>Active Staff Details</h3>

  <table border="1" cellpadding="8" cellspacing="0"
  style="border-collapse:collapse;">

    <tr style="background:#1e3a8a;color:white;">

      <th>SL. No.</th>
      <th>Name</th>
      <th>Role</th>
      <th>Resource ID</th>
      <th>Active</th>
      <th>Assigned Shift</th>

    </tr>

  `;

  // =================================
  // ACTIVE STAFF DETAILS
  // EXCLUDE ADMIN
  // =================================
// Sort Active Staff by Fixed Role Order
const activeStaff = rows.slice(1).filter(function(r){

  return (
    String(r[10]).trim().toUpperCase() === "YES" &&
    String(r[8]).trim().toLowerCase() !== "admin"
  );

});

activeStaff.sort(function(a,b){

  const roleA = roleOrder.indexOf(String(a[8]).trim());
  const roleB = roleOrder.indexOf(String(b[8]).trim());

  return (roleA === -1 ? 999 : roleA) -
         (roleB === -1 ? 999 : roleB);

});

let slNo = 1;

activeStaff.forEach(function(r){

    const role = String(r[8]).trim();

    const active =
      String(r[10]).trim().toUpperCase();

    if(
      active === "YES" &&
      role.toLowerCase() !== "admin"
    ){

      html += `

      <tr>

        <td>${slNo++}</td>

        <td>${r[1]}</td>

        <td>${r[8]}</td>

        <td>${r[9]}</td>

        <td>${r[10]}</td>

        <td>${r[12]}</td>

      </tr>

      `;

    }

  });

  html += `

  </table>

  `;

  // =================================
  // SEND EMAIL
  // =================================

  MailApp.sendEmail({

    to: ownerEmail,

    subject:
      "Staff Duty Assignment Updated - " +
      Utilities.formatDate(
        new Date(),
        Session.getScriptTimeZone(),
        "dd/MM/yyyy"
      ),

    htmlBody: html

  });

  return "Staff details updated successfully.";

}


