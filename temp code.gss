function saveCheckOut(
  resourceId,
  latitude,
  longitude,
  shiftCount,
  checkoutDevice
){


 const ss =
   SpreadsheetApp.openById(
     LOGIN_SPREADSHEET_ID
   );


 const attendanceSheet =
   ss.getSheetByName(
     "ATTENDANCE_LOG"
   );


 const settingsSheet =
   ss.getSheetByName(
     "SETTINGS"
   );


 const centerLat =
   settingsSheet.getRange("A2").getValue();


 const centerLng =
   settingsSheet.getRange("B2").getValue();


 const distance =
   Math.round(
     calculateDistance(
       Number(centerLat),
       Number(centerLng),
       Number(latitude),
       Number(longitude)
     )
   );
   const radius =
  settingsSheet.getRange("C2")
  .getValue();

if(distance > radius){

  return {

    success:false,

    message:
    "You are outside center by " +
    distance +
    " meters"

  };

}


 const today =
   Utilities.formatDate(
     new Date(),
     Session.getScriptTimeZone(),
     "dd-MM-yyyy"
   );


 const rows =
   attendanceSheet
   .getDataRange()
   .getValues();
   // ===============================
// VERIFY ASSIGNED SHIFT
// ===============================

const staffSheet =
ss.getSheetByName("STAFF_MASTER");

const staffData =
staffSheet.getDataRange().getValues();

let assignedShift = "";

for(let k=1;k<staffData.length;k++){

  if(
    String(staffData[k][9]).trim() ===
    String(resourceId).trim()
  ){

    assignedShift = Number(staffData[k][12]);
    break;

  }

}

// Check whether entered shift matches assigned shift
if(Number(shiftCount) !== assignedShift){

  return{

    success:false,

    message:
    "You are assigned for " +
    assignedShift +
    " shift(s) by the Center Head.\n\nYou cannot enter " +
    shiftCount +
    " shift(s)."

  };

}


 for(let i=rows.length-1;i>=1;i--){


   const rowDate =
     Utilities.formatDate(
       new Date(rows[i][0]),
       Session.getScriptTimeZone(),
       "dd-MM-yyyy"
     );


   if(


     rowDate === today &&


     String(rows[i][9]).trim() ===
     String(resourceId).trim()


   ){


     const checkInTime =
       new Date(rows[i][10]);


     const checkOutTime =
       new Date();


     const durationMs =
       checkOutTime - checkInTime;


     const hours =
       Math.floor(durationMs / 3600000);


     const minutes =
       Math.floor(
         (durationMs % 3600000) / 60000
       );


     const duration =
       hours + " Hr " +
       minutes + " Min";


     attendanceSheet
       .getRange(i+1,12)
       .setValue(checkOutTime);


     attendanceSheet
       .getRange(i+1,13)
       .setValue(duration);


     attendanceSheet
       .getRange(i+1,16)
       .setValue(latitude);


     attendanceSheet
       .getRange(i+1,17)
       .setValue(longitude);


     attendanceSheet
       .getRange(i+1,19)
       .setValue(distance);


     attendanceSheet
       .getRange(i+1,21)
       .setValue("Checked-Out");
attendanceSheet
.getRange(i+1,23)
.setValue(shiftCount);
attendanceSheet
.getRange(i+1,25)
.setValue(checkoutDevice);
//==============================
// AUTO PAYMENT CALCULATION
//==============================

const paymentSheet =
ss.getSheetByName("Payment Details");

const paymentData =
paymentSheet.getDataRange().getValues();

const role = rows[i][8];        // Exam Role (Column I)
const shift = Number(shiftCount);

let amount = 0;

for (let j = 1; j < paymentData.length; j++) {

  if (
      String(paymentData[j][1]).trim() === String(role).trim() &&
      Number(paymentData[j][2]) === shift
  ) {

      amount = Number(paymentData[j][3]);
      break;

  }

}

// Save Amount in Column Z
attendanceSheet
  .getRange(i + 1, 26)
  .setValue(amount);
const threadId =
attendanceSheet
  .getRange(i + 1, 22)
  .getValue();

Logger.log("Thread ID = " + threadId);

const userEmail =
attendanceSheet
  .getRange(i + 1, 4)
  .getValue();

const checkoutDate =
Utilities.formatDate(
  checkOutTime,
  Session.getScriptTimeZone(),
  "dd/MM/yyyy"
);

const checkoutClock =
Utilities.formatDate(
  checkOutTime,
  Session.getScriptTimeZone(),
  "hh:mm a"
);

const checkoutHtml = `
<div style="font-family:Arial,sans-serif;
max-width:650px;
margin:auto;
border:1px solid #ddd;
border-radius:10px;
overflow:hidden;">

<div style="
background:#1e3a8a;
padding:20px;
color:white;
text-align:center;">

<h2>
RADHA RAMAN ASSESSMENT SERVICES
</h2>

<p>
Attendance Check-Out Confirmation
</p>

</div>

<div style="padding:20px;">

<p>
Dear <b>${rows[i][1]}</b>,
</p>

<p>
Your check-out attendance has been successfully recorded.
</p>

<table
style="
width:100%;
border-collapse:collapse;
">

<tr>
<td><b>Name</b></td>
<td>${rows[i][1]}</td>
</tr>

<tr>
<td><b>Resource ID</b></td>
<td>${resourceId}</td>
</tr>

<tr>
<td><b>Date</b></td>
<td>${checkoutDate}</td>
</tr>

<tr>
<td><b>Check-In Time</b></td>
<td>
${Utilities.formatDate(
  checkInTime,
  Session.getScriptTimeZone(),
  "hh:mm a"
)}
</td>
</tr>

<tr>
<td><b>Check-Out Time</b></td>
<td>${checkoutClock}</td>
</tr>

<tr>
<td><b>Duration</b></td>
<td>${duration}</td>
</tr>

<tr>
<td><b>Shift Count</b></td>
<td>${shiftCount}</td>
</tr>

<tr>
<td><b>Distance From Center</b></td>
<td>${distance} meters</td>
</tr>

<tr>
<td><b>Status</b></td>
<td style="color:red;">
Checked-Out Successfully
</td>
</tr>

</table>

<br>

<div style="
background:#f3f4f6;
padding:15px;
border-left:4px solid #ef4444;
">

Your examination duties have been completed successfully.

Thank you for your contribution to the examination process.

</div>

<br>

Regards,<br>
<b>RRAS Attendance System</b><br>
Radha Raman Assessment Services Pvt Ltd

</div>

<div style="
background:#f8fafc;
padding:15px;
text-align:center;
font-size:12px;
color:#666;">

This is an automated email.
Please do not reply.

</div>

</div>
`;

if(threadId){

  try{

const threadId =
attendanceSheet
.getRange(i+1,22)
.getValue();

if(threadId){

  GmailApp
    .getThreadById(threadId)
    .replyAll(
      "",
      {
        htmlBody: checkoutHtml
      }
    );

}

  }
  catch(err){

    Logger.log(err);

  }

}


     return {
       success:true,
       message:"Check-Out Successful"
     };


   }


 }


 return {
   success:false,
   message:"No Check-In Found Today"
 };


}

function getAttendanceHistory(resourceId){

  Logger.log("Resource = " + resourceId);

  const ss =
    SpreadsheetApp.openById(
      LOGIN_SPREADSHEET_ID
    );

  const sheet =
    ss.getSheetByName(
      "ATTENDANCE_LOG"
    );

  const data =
    sheet.getDataRange()
    .getValues();

  let result = [];

  for(let i=data.length-1;i>=1;i--){

    Logger.log(
      "Sheet Resource = " +
      data[i][9]
    );

    if(
      String(data[i][9]).trim() ===
      String(resourceId).trim()
    ){

      result.push({

        date:data[i][0],
        checkIn:data[i][10],
        checkOut:data[i][11],
        duration:data[i][12],
        status:data[i][20]

      });

    }

  }

  Logger.log(
    JSON.stringify(result)
  );

  return result;

}
function sendAttendanceReport(
  resourceId,
  fromDate,
  toDate
){

  const ss =
    SpreadsheetApp.openById(
      LOGIN_SPREADSHEET_ID
    );

  const attendance =
    ss.getSheetByName(
      "ATTENDANCE_LOG"
    );

  const rows =
    attendance.getDataRange()
    .getValues();

  const user =
    getDashboardUser(resourceId);

  let html = `
  <h2>Attendance Report</h2>

  <table border='1'
  cellpadding='5'
  cellspacing='0'>

  <tr>
  <th>Date</th>
  <th>Check-In</th>
  <th>Check-Out</th>
  <th>Duration</th>
  </tr>
  `;

  for(let i=1;i<rows.length;i++){

    const rowDate =
      Utilities.formatDate(
        new Date(rows[i][0]),
        Session.getScriptTimeZone(),
        "yyyy-MM-dd"
      );

    if(

      String(rows[i][9]).trim() ==
      String(resourceId).trim()

      &&

      rowDate >= fromDate

      &&

      rowDate <= toDate

    ){

const reportDate =
Utilities.formatDate(
  new Date(rows[i][0]),
  Session.getScriptTimeZone(),
  "dd/MM/yyyy"
);

const checkIn =
rows[i][10]
?
Utilities.formatDate(
  new Date(rows[i][10]),
  Session.getScriptTimeZone(),
  "hh:mm a"
)
:
"-";

const checkOut =
rows[i][11]
?
Utilities.formatDate(
  new Date(rows[i][11]),
  Session.getScriptTimeZone(),
  "hh:mm a"
)
:
"-";
html += `
<tr>
<td>${reportDate}</td>
<td>${checkIn}</td>
<td>${checkOut}</td>
<td>${rows[i][12] || "-"}</td>
</tr>
`;

    }

  }

  html += "</table>";

  MailApp.sendEmail({

    to:user.email,

    subject:
    "RRAS Attendance Report",

    htmlBody:html

  });

  return "Attendance report sent to your email.";

}
function checkDuplicateDevice(deviceInfo, resourceId){

  const ss =
    SpreadsheetApp.openById(
      LOGIN_SPREADSHEET_ID
    );

  const sheet =
    ss.getSheetByName(
      "ATTENDANCE_LOG"
    );

  const rows =
    sheet.getDataRange()
    .getValues();

  const today =
    Utilities.formatDate(
      new Date(),
      Session.getScriptTimeZone(),
      "dd-MM-yyyy"
    );

  for(let i=rows.length-1;i>=1;i--){

    const rowDate =
      Utilities.formatDate(
        new Date(rows[i][0]),
        Session.getScriptTimeZone(),
        "dd-MM-yyyy"
      );

    if(
      rowDate === today &&
      String(rows[i][23]).trim() ===
      String(deviceInfo).trim() &&
      String(rows[i][9]).trim() !==
      String(resourceId).trim()
    ){

      return true;

    }

  }

  return false;

}
function sendDuplicateMail(userData){

  const ss =
    SpreadsheetApp.openById(
      LOGIN_SPREADSHEET_ID
    );

  const settingsSheet =
    ss.getSheetByName(
      "SETTINGS"
    );

  const ownerEmail =
    settingsSheet.getRange("D2").getValue();

  MailApp.sendEmail({

    to: ownerEmail,

    subject:
    "Duplicate Mobile Alert",

    htmlBody:

    "Staff Name : " +
    userData.name +

    "<br><br>Resource ID : " +
    userData.resourceId +

    "<br><br>This staff has agreed to check in using a mobile already used today."

  });

}
